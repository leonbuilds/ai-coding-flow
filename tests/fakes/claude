#!/usr/bin/env python3
"""测试用的假 claude：记录调用；-p 模式把预设结论打印到 stdout。"""
import json, os, sys
log = os.environ.get("FAKE_LOG")
if log:
    with open(log, "a") as f:
        f.write("claude " + json.dumps(sys.argv[1:], ensure_ascii=False) + "\n")
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("0.0.0 (Claude Code fake)"); sys.exit(0)
if "-p" in a:
    sys.stdin.read()
    print(os.environ.get("FAKE_VERDICT", "结论：PASS\n"))
sys.exit(0)
