#!/usr/bin/env python3
"""测试用的假 codex：记录调用，按环境变量返回预设结果。"""
import json, os, sys
log = os.environ.get("FAKE_LOG")
if log:
    with open(log, "a") as f:
        f.write("codex " + json.dumps(sys.argv[1:], ensure_ascii=False) + "\n")
a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("codex-cli 0.0.0-fake"); sys.exit(0)
if a[:3] == ["mcp", "list", "--json"]:
    p = os.environ.get("FAKE_CODEX_MCP")
    print(open(p).read() if p and os.path.exists(p) else "[]"); sys.exit(0)
if a[:1] == ["mcp"]:
    sys.exit(0)
if a[:1] == ["exec"]:
    prompt = sys.stdin.read()
    if os.environ.get("FAKE_PROMPT_LOG"):
        open(os.environ["FAKE_PROMPT_LOG"], "a").write(prompt + "\n=====\n")
    out = a[a.index("-o") + 1]
    cwd = a[a.index("-C") + 1]
    if os.environ.get("FAKE_ADD"):
        open(os.path.join(cwd, os.environ["FAKE_ADD"]), "w").write("cache\n")
    if os.environ.get("FAKE_TOUCH"):
        open(os.path.join(cwd, os.environ["FAKE_TOUCH"]), "a").write("changed by reviewer\n")
    open(out, "w").write(os.environ.get("FAKE_VERDICT", "结论：PASS\n\n发现：无\n"))
    sys.exit(int(os.environ.get("FAKE_EXIT", "0")))
sys.exit(0)
